# ===== LLM 接入（D-12：统一适配器，禁止硬编码供应商；密钥只存 .env，不入库） =====
# 开发期公网 OpenAI 兼容 API fallback（P3 §4.7 允许）；生产强制私有化 vLLM
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=your_api_key
LLM_MODEL=Qwen/Qwen3-8B
LLM_EMBEDDING_MODEL=BAAI/bge-m3

# ===== PostgreSQL 17 =====
POSTGRES_USER=sonarcad
POSTGRES_PASSWORD=change_me_in_env
POSTGRES_DB=sonarcad
POSTGRES_PORT=5432

# ===== Neo4j 5 =====
NEO4J_AUTH=neo4j/change_me_in_env
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ===== MinIO（S3 协议；分桶见 P3 §7.7） =====
MINIO_ROOT_USER=sonarcad
MINIO_ROOT_PASSWORD=change_me_in_env
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===== Redis 7.2 =====
REDIS_PASSWORD=change_me_in_env
REDIS_PORT=6379

# ===== RabbitMQ =====
RABBITMQ_DEFAULT_USER=sonarcad
RABBITMQ_DEFAULT_PASS=change_me_in_env
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ===== Java 平台层 =====
JWT_SECRET=change_me_in_env

# ===== 镜像加速（国内网络拉 Docker Hub 失败时启用；变量带结尾斜杠，留空=直连官方源） =====
# 方案 a（推荐）：Docker Desktop Settings → Docker Engine 配 registry-mirrors，本组留空即可
# 方案 b：取消注释下行（quay.io 源如失败也一并配）
#DOCKER_MIRROR=docker.m.daocloud.io/
#QUAY_MIRROR=quay.m.daocloud.io/

# ===== Host 端口覆盖 =====
# 本机已被其它容器占用 7474/7687/9000/9001 时，在此改 host 侧端口（容器内端口不变）
#NEO4J_HTTP_PORT=17474
#NEO4J_BOLT_PORT=17687
#MINIO_API_PORT=19000
#MINIO_CONSOLE_PORT=19001

# ===== 算力层 py-engine（T1.2） =====
CELERY_BROKER_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST:localhost}:${RABBITMQ_AMQP_PORT}/
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST:localhost}:${REDIS_PORT}/0
WORKFLOW_BASE_URL=http://localhost:8082

# ===== 网关限流/熔断（T9.4，全部可选，默认值见 gateway application.yml） =====
#RL_PY_REPLENISH=20          # py 算力路由令牌回补（个/秒/用户）
#RL_PY_BURST=60              # py 算力路由桶容量
#RL_WF_REPLENISH=50          # workflow 路由回补
#RL_WF_BURST=150
#RL_AUTH_REPLENISH=10        # 登录路由回补（无 token 按 IP 计）
#RL_AUTH_BURST=30
#RL_RETRY_AFTER_SECONDS=1    # 429 结构化体的建议重试等待（秒）
#CB_RETRY_AFTER_SECONDS=30   # 熔断 503 的建议重试等待（秒，对齐 waitDurationInOpenState）

# ---- 监控（T10.1c，PHASE-010，--profile monitoring；可选） ----
#PROMETHEUS_PORT=9090
#ALERTMANAGER_PORT=9093
#GRAFANA_PORT=3300
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=admin
