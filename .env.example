# ===== LLM 接入（D-12：统一适配器，禁止硬编码供应商；密钥只存 .env，不入库） =====
# 开发期公网 OpenAI 兼容 API fallback（P3 §4.7 允许）；生产强制私有化 vLLM
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=your_api_key
LLM_MODEL=Qwen/Qwen3-8B
LLM_EMBEDDING_MODEL=BAAI/bge-m3

# ===== PostgreSQL 17 =====
POSTGRES_USER=sonarcad
POSTGRES_PASSWORD=change_me_in_env
POSTGRES_DB=sonarcad
POSTGRES_PORT=5432

# ===== Neo4j 5 =====
NEO4J_AUTH=neo4j/change_me_in_env
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ===== MinIO（S3 协议；分桶见 P3 §7.7） =====
MINIO_ROOT_USER=sonarcad
MINIO_ROOT_PASSWORD=change_me_in_env
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===== Redis 7.2 =====
REDIS_PASSWORD=change_me_in_env
REDIS_PORT=6379

# ===== RabbitMQ =====
RABBITMQ_DEFAULT_USER=sonarcad
RABBITMQ_DEFAULT_PASS=change_me_in_env
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ===== Java 平台层 =====
JWT_SECRET=change_me_in_env
