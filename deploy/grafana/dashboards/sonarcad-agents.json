{
 "uid": "sonarcad-agents",
 "title": "Sonar-CAD Agent 管线",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "15s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "annotations": {
  "list": []
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Agent 任务吞吐（stage × result）",
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(py_agent_task_total[5m])) by (stage, result)",
     "legendFormat": "{{stage}}/{{result}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Agent 阶段耗时 P50 / P95",
   "description": "T10.3 性能基线数据源；P95 视图对照 NFR",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.50, sum(rate(py_agent_task_duration_seconds_bucket[10m])) by (le, stage))",
     "legendFormat": "p50 {{stage}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum(rate(py_agent_task_duration_seconds_bucket[10m])) by (le, stage))",
     "legendFormat": "p95 {{stage}}",
     "refId": "A"
    }
   ]
  },
