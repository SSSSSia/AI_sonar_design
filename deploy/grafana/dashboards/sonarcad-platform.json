{
 "uid": "sonarcad-platform",
 "title": "Sonar-CAD 平台总览",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "15s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "annotations": {
  "list": []
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "py-engine API QPS（按路由）",
   "description": "py-engine HTTP 请求速率（T10.1a 埋点）",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(py_http_requests_total[1m])) by (route)",
     "legendFormat": "{{route}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "py-engine API 延迟 P95（按路由）",
   "description": "",
